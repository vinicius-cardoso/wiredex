# Local development settings. Copy to .env (gitignored) and adjust if needed;
# every value below is also the default, so .env is optional.

# Postgres in compose.yaml
POSTGRES_USER=wiredex
POSTGRES_PASSWORD=wiredex
POSTGRES_DB=wiredex
# 5442, not 5432: the usual Postgres ports are often taken by other projects.
POSTGRES_PORT=5442

# API
WIREDEX_ENVIRONMENT=development
# The API logs in as wiredex_app, which row-level security applies to; `wiredex db`
# commands log in as the schema owner. `make migrate` gives wiredex_app its password.
WIREDEX_DATABASE_URL=postgresql+asyncpg://wiredex_app:wiredex_app@localhost:5442/wiredex
WIREDEX_ADMIN_DATABASE_URL=postgresql+asyncpg://wiredex:wiredex@localhost:5442/wiredex
