{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["wiredex.bootstrap.app:create_app", "--factory", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "python": "${workspaceFolder}/apps/api/.venv/bin/python"
    },
    {
      "name": "Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [{ "name": "API + Web", "configurations": ["API (debug)", "Web (Chrome)"] }]
}
